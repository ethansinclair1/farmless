# Copy this file to .env and fill in real values before running

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma separated list of Google emails allowed into /admin
ADMIN_EMAILS=you@example.com

# Public URL the app is running on (used to build Stripe redirect links)
BASE_URL=http://localhost:3000
