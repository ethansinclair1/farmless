<%- include('partials/header') %>

<h1 style="margin-top:32px">My orders</h1>

<% if (orders.length === 0) { %>
  <div class="empty-state">
    <p>No orders yet.</p>
    <a class="btn" href="/">Start shopping</a>
  </div>
<% } else { %>
  <table class="lines" style="margin-bottom:60px">
    <thead><tr><th>Order</th><th>Server</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= o.server_label %></td>
          <td>$<%= (o.total_cents / 100).toFixed(2) %></td>
          <td><span class="badge <%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
          <td><a href="/orders/<%= o.id %>" class="btn secondary small">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
