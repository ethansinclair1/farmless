<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== "undefined" ? title : "Farmless" %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">Farm<span>less</span></a>
      <nav class="main">
        <a href="/">Shop</a>
        <a href="/cart">Cart<% if (cartCount > 0) { %><span class="pill"><%= cartCount %></span><% } %></a>
        <% if (user) { %>
          <a href="/orders">My Orders</a>
          <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
          <span class="user-chip">
            <% if (user.avatar_url) { %><img src="<%= user.avatar_url %>" alt="" /><% } %>
            <form method="POST" action="/auth/logout" style="display:inline">
              <button type="submit" class="btn secondary small">Log out</button>
            </form>
          </span>
        <% } else { %>
          <a href="/auth/google" class="btn small">Sign in with Google</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap">
