<%- include('partials/header') %>

<h1 style="margin-top:32px">Admin &mdash; all orders</h1>

<table class="admin" style="margin-bottom:60px">
  <thead>
    <tr><th>Order</th><th>Customer</th><th>Server</th><th>Steam</th><th>Total</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% orders.forEach(function(o) { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><%= o.customer_name %><br /><span style="color:var(--text-dim)"><%= o.customer_email %></span></td>
        <td><%= o.server_label %></td>
        <td><%= o.steam_username %></td>
        <td>$<%= (o.total_cents / 100).toFixed(2) %></td>
        <td><span class="badge <%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
        <td><a href="/orders/<%= o.id %>" class="btn secondary small">Open</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>
